# ===== General =====
PORT=3000
# URL pública de la tienda (con https cuando tengas dominio). Se usa en enlaces de descarga y en el bot.
BASE_URL=http://localhost:3000
STORE_NAME=Pixelia
# Idioma por defecto (es / en)
DEFAULT_LANG=es
# Secreto para firmar enlaces de descarga (pon algo largo y aleatorio)
APP_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Contraseña del panel /admin
ADMIN_PASSWORD=cambia-esta-clave
# Descargas permitidas por pedido y horas que dura el enlace
MAX_DOWNLOADS=5
LINK_HOURS=72

# ===== Telegram =====
# Token del bot (créalo con @BotFather)
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin @ (ej: MiTiendaBot)
TELEGRAM_BOT_USERNAME=
# Tu chat id (escríbele /id al bot para verlo). Recibirás avisos y confirmarás pagos Binance.
TELEGRAM_ADMIN_CHAT_ID=

# ===== PayPal (automático) =====
# sandbox para pruebas, live para producción
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ===== Binance Pay (semiautomático) =====
# Tu Binance Pay ID (el número que ve el cliente para enviarte el pago)
BINANCE_PAY_ID=
# Opcional: API key de SOLO LECTURA para verificar pagos automáticamente.
# Si lo dejas vacío, confirmas cada pago con un botón en Telegram.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== Correo (Resend, https://resend.com) =====
RESEND_API_KEY=
# Remitente verificado en Resend, ej: Tienda <ventas@tudominio.com>
EMAIL_FROM=

# ===== n8n (radar de tendencias y rendimiento) =====
# Clave larga y aleatoria; ponla igual en el nodo "Config" de cada flujo de n8n.
N8N_API_KEY=

# ===== Meta (Facebook/Instagram Ads) =====
# Píxel para medir ventas de los anuncios (Administrador de eventos → Orígenes de datos)
META_PIXEL_ID=
# Token de la API de Conversiones (mismo sitio → Configuración → Generar token). Mide ventas aunque bloqueen el píxel.
META_CAPI_TOKEN=
# Opcional, solo para probar eventos en el Administrador de eventos
META_TEST_EVENT_CODE=

# ===== WhatsApp Cloud API (Meta) — opcional, apagado si lo dejas vacío =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombre de la plantilla aprobada en Meta con 1 variable ({{1}} = enlace de descarga)
WHATSAPP_TEMPLATE=entrega_pedido
WHATSAPP_TEMPLATE_LANG=es
